# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_view.db
$RECYCLE.BIN/

# --- Editor / IDE ---
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# --- Logs / Scratch ---
*.log
logs/
temp/

# --- Credentials / Secrets (never commit) ---
*.env
*.env.*
*.pfx
*.p12
*.keystore
credentials/
secrets/

# --- Windows binaries ---
*.exe
*.dll
*.pdb
*.obj
*.lib
*.ilk
*.exp
*.cache

# --- .NET build outputs ---
bin/
obj/
*.user
*.suo

# --- Office / Lock-Files ---
~$*
*.lock

# --- Blue Prism typical artifacts (add specifics as project grows) ---
*.bpobject.bak
*.bprelease.bak
*.releasepack.bak

# --- bpgit runtime/test artifacts ---
.bpgit/                        # runtime config dir (contains bpgit-server.json with BP password)
processes/                      # test worktree from smoke-phase4c.ps1
src/BPGit.Server/BPGit.Server.http   # .http test artifact from `dotnet new webapi` scaffold
src/BPGit.Server/Properties/    # launchSettings.json (debug-only)
# --- Blue Prism Education License (lokal, nie committen) ---
*.lic

