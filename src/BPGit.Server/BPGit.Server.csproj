<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BPGit.Server</RootNamespace>
    <AssemblyName>bpgit</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="bpgit.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.324" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BPGit.Cli\BPGit.Cli.csproj" />
    <ProjectReference Include="..\BPGit.Data\BPGit.Data.csproj" />
  </ItemGroup>

</Project>