<Project>
  <!--
    Self-contained single-file publish profile for BPGit.Server.

    Builds a single .exe that includes the .NET 10 runtime and all native libraries
    (LibGit2Sharp, etc.) — no .NET runtime install required on the target.

    Usage (CLI):
      dotnet publish src/BPGit.Server/BPGit.Server.csproj `
        /p:PublishProfile=SelfContainedSingleFile `
        /p:Configuration=Release

    Output (single executable, ~80-100 MB):
      src/BPGit.Server/bin/publish/win-x64-self-contained/bpgit-server.exe

    Use case: scp/copy the single .exe to a target machine without .NET 10 Runtime
    installed. Slower cold-start (R2R + ReadyToRun disabled for single-file).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>bin\publish\win-x64-self-contained\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
