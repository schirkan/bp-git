<Project>
  <!--
    Folder publish profile for BPGit.Server (self-hosted git-server + unified CLI).

    Usage (CLI):
      dotnet publish src/BPGit.Server/BPGit.Server.csproj `
        /p:PublishProfile=FolderProfile `
        /p:Configuration=Release

    Output (framework-dependent, requires .NET 10 Runtime on target):
      src/BPGit.Server/bin/publish/win-x64/bpgit-server.exe
      src/BPGit.Server/bin/publish/win-x64/*.deps.json
      src/BPGit.Server/bin/publish/win-x64/*.runtimeconfig.json
      src/BPGit.Server/bin/publish/win-x64/*.dll (LibGit2Sharp, etc.)

    Invoke on the target:
      bpgit-server.exe --serve                    # Kestrel (default config)
      bpgit-server.exe --serve my-config.json     # Kestrel with custom config
      bpgit-server.exe --serve init my-repo       # Bare-Repo bootstrap
      bpgit-server.exe init --install-hooks       # CLI: worktree init
      bpgit-server.exe pull                       # CLI: BP-DB -> worktree
      bpgit-server.exe status                     # CLI: drift report
      bpgit-server.exe commit --force             # CLI: write back to BP-DB
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
