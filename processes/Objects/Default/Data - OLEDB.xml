ored Procedure with Return Value</name><view><camerax>-89</camerax><cameray>-21</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="1ab0d89a-87ab-4c08-90ed-ffbb975c2704" type="Normal" published="True"><name>Execute Stored Procedure with Outputs</name><view><camerax>-89</camerax><cameray>-38</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="9ad00c3c-8615-4f62-9595-9081a2523133" type="Normal" published="True"><name>Execute</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="f3bf5e12-d2cf-4c5d-bda5-0deae3c26316" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>d16cc64f-d5d1-4aaf-bea5-f814e1f2657b</onsuccess></stage><stage stageid="d16cc64f-d5d1-4aaf-bea5-f814e1f2657b" name="End" type="End"><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="0efcc61e-6916-4463-ae94-c24edb2adc75" name="Stage1" type="ProcessInfo"><loginhibit /><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /><references><reference>System.Data.dll</reference><reference>System.XML.dll</reference></references><imports><import>System</import><import>System.Data</import><import>System.Data.OLEDB</import></imports><language>visualbasic</language><pythondllpath></pythondllpath><pythonenvpath></pythonenvpath><globalcode><![CDATA[

]]></globalcode><code><![CDATA[Private moConnection As OLEDBConnection

Private Function ConvertValue(value As String, oleDbType As OleDbType) As Object
    If String.IsNullOrEmpty(value) Then
        Return DBNull.Value
    End If
    
    Try
        Select Case oleDbType
            Case OleDbType.Integer
                Return Integer.Parse(value)
            Case OleDbType.BigInt
                Return Long.Parse(value)
            Case OleDbType.SmallInt
                Return Short.Parse(value)
            Case OleDbType.TinyInt, OleDbType.UnsignedTinyInt
                Return Byte.Parse(value)
            Case OleDbType.Boolean
                Return Boolean.Parse(value)
            Case OleDbType.Single
                Return Single.Parse(value)
            Case OleDbType.Double
                Return Double.Parse(value)
            Case OleDbType.Decimal, OleDbType.Numeric, OleDbType.Currency
                Return Decimal.Parse(value)
            Case OleDbType.Date, OleDbType.DBDate, OleDbType.DBTimeStamp
                Return DateTime.Parse(value)
            Case OleDbType.Guid
                Return Guid.Parse(value)
            Case OleDbType.VarChar, OleDbType.Char, OleDbType.WChar, OleDbType.VarWChar, _
                 OleDbType.LongVarChar, OleDbType.LongVarWChar, OleDbType.BSTR
                Return value
            Case Else
                Return value ' Default to string
        End Select
    Catch
        Return value ' If conversion fails, return original string
    End Try
End Function
		

Public Function ExecuteStoredProcedure(connection as OLEDBConnection, procedureName As String, parameters As DataTable) As DataTable
	Dim oDataAdapter as OLEDBDataAdapter
	Dim oDataSet as New DataSet
        Using command As New OleDbCommand(procedureName, connection) 
            command.CommandType = CommandType.StoredProcedure
            if not IsNothing(parameters) then
				For Each row As DataRow In parameters.Rows
					Dim paramName As String = row("ParamName").ToString()
					Dim paramTypeString As String = row("ParamType").ToString()
					Dim paramValue As String = row("ParamValue").ToString()
					
					' Parse the OleDbType
					Dim paramType As OleDbType
					If [Enum].TryParse(Of OleDbType)(paramTypeString, True, paramType) Then
						' Convert the string value to appropriate type
						Dim convertedValue As Object = ConvertValue(paramValue, paramType)
						
						' Add parameter with size if needed
						If parameters.Columns.Contains("ParamSize") AndAlso Not row.IsNull("ParamSize") Then
							Dim size As Integer = Convert.ToInt32(row("ParamSize"))
							command.Parameters.Add(paramName, paramType, size).Value = convertedValue
						Else
							command.Parameters.Add(paramName, paramType).Value = convertedValue
						End If
					End If
				Next
            end if
			oDataAdapter = new OLEDBDataAdapter(command)
			oDataAdapter.Fill(oDataSet)
            
        End Using

	return oDataSet.Tables(0)

End Function


Public Function ExecuteStoredProcedureWithReturn(connection As OLEDBConnection, procedureName As String, parameters As DataTable) As Object
   ' Using connection As New OleDbConnection(connectionString)
        Using command As New OleDbCommand(procedureName, connection)
            command.CommandType = CommandType.StoredProcedure
            
            ' Add the return value parameter
            Dim returnParameter As OleDbParameter = command.Parameters.Add("@ReturnValue", OleDbType.Integer)
            returnParameter.Direction = ParameterDirection.ReturnValue
            
            ' Add input parameters
            For Each row As DataRow In parameters.Rows
                Dim paramName As String = row("ParamName").ToString()
                Dim paramTypeString As String = row("ParamType").ToString()
                Dim paramValue As String = row("ParamValue").ToString()
                
                ' Parse the OleDbType
                Dim paramType As OleDbType
                If [Enum].TryParse(Of OleDbType)(paramTypeString, True, paramType) Then
                    ' Convert the string value to appropriate type
                    Dim convertedValue As Object = ConvertValue(paramValue, paramType)
                    
                    ' Add parameter with size if needed
                    If parameters.Columns.Contains("ParamSize") AndAlso Not row.IsNull("ParamSize") Then
                        Dim size As Integer = Convert.ToInt32(row("ParamSize"))
                        command.Parameters.Add(paramName, paramType, size).Value = convertedValue
                    Else
                        command.Parameters.Add(paramName, paramType).Value = convertedValue
                    End If
                End If
            Next
            
           ' connection.Open()
            command.ExecuteNonQuery()
            
            ' Return the return value
            Return returnParameter.Value
        End Using
    'End Using
End Function

Public Function ExecuteStoredProcedureWithOutputs(connection As OLEDBConnection, procedureName As String, _
                                                   parameters As DataTable, ByRef outputParams As DataTable) As Object
   ' Using connection As New OleDbConnection(connectionString)
        Using command As New OleDbCommand(procedureName, connection)
            command.CommandType = CommandType.StoredProcedure
            
            ' Add the return value parameter
            Dim returnParameter As OleDbParameter = command.Parameters.Add("@ReturnValue", OleDbType.Integer)
            returnParameter.Direction = ParameterDirection.ReturnValue
            
            ' Add parameters
            For Each row As DataRow In parameters.Rows
                Dim paramName As String = row("ParamName").ToString()
                Dim paramTypeString As String = row("ParamType").ToString()
                Dim paramValue As String = row("ParamValue").ToString()
                Dim paramDirection As String = If(parameters.Columns.Contains("ParamDirection"), _
                                                   row("ParamDirection").ToString(), "Input")
                
                ' Parse the OleDbType
                Dim paramType As OleDbType
                If [Enum].TryParse(Of OleDbType)(paramTypeString, True, paramType) Then
                    ' Convert the string value to appropriate type
                    Dim convertedValue As Object = ConvertValue(paramValue, paramType)
                    
				
                    ' Create parameter
                    Dim param As OleDbParameter
                    If parameters.Columns.Contains("ParamSize") AndAlso Not row.IsNull("ParamSize") Then
                        Dim size As Integer = Convert.ToInt32(row("ParamSize"))
                        param = command.Parameters.Add(paramName, paramType, size)
                    Else
                        param = command.Parameters.Add(paramName, paramType)
                    End If
                    
                    ' Set direction
                    Select Case paramDirection.ToLower()
                        Case "output"
                            param.Direction = ParameterDirection.Output
                        Case "inputoutput"
                            param.Direction = ParameterDirection.InputOutput
                            param.Value = convertedValue
                        Case Else
                            param.Direction = ParameterDirection.Input
                            param.Value = convertedValue
                    End Select
                End If
            Next
            
          '  connection.Open()
            command.ExecuteNonQuery()
			
            
            ' Populate output parameters collection
            If outputParams IsNot Nothing Then
                outputParams.Clear()
                outputParams.Columns.Clear()
                outputParams.Columns.Add("ParamName", GetType(String))
                outputParams.Columns.Add("ParamValue", GetType(String))
                
                For Each param As OleDbParameter In command.Parameters
                    If param.Direction = ParameterDirection.Output OrElse _
                       param.Direction = ParameterDirection.InputOutput Then
                        Dim outputRow As DataRow = outputParams.NewRow()
                        outputRow("ParamName") = param.ParameterName
                        outputRow("ParamValue") = If(param.Value Is Nothing, "", param.Value.ToString())
						outputParams.Rows.Add(outputRow)
                    End If
                Next
            End If
            
            ' Return the return value
            Return returnParameter.Value
        End Using
   ' End Using
End Function]]></code></stage><stage stageid="fd95e8ae-614b-4bae-a0f9-cbd04cef37ce" name="Clean Up" type="SubSheetInfo"><subsheetid>cfb6da91-518b-40a3-8e0e-115ff0252ea7</subsheetid><loginhibit /><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="e91da0c2-e60f-4eae-a108-bd99aaff046f" name="Start" type="Start"><subsheetid>cfb6da91-518b-40a3-8e0e-115ff0252ea7</subsheetid><loginhibit /><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><onsuccess>88b89098-8bb2-42fc-8e43-bad5b1e4f400</onsuccess></stage><stage stageid="91836284-14a0-4c0f-b9d5-8cd74b4d1632" name="End" type="End"><subsheetid>cfb6da91-518b-40a3-8e0e-115ff0252ea7</subsheetid><loginhibit /><display x="15" y="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="cf7a7a0d-0c2b-4a9e-8a52-19bdf46ef4cc" name="Set Connection" type="SubSheetInfo"><subsheetid>90429413-7792-4513-8bc0-d6d079aa08b9</subsheetid><loginhibit /><narrative>Sets the connection details for the database.</narrative><display x="-195" y="-105" w="150" h="90" /><font family="Tahoma" size="10" style="Regular" color="000000" /></stage><stage stageid="5395eb12-61a3-4005-88a3-ceda307cf9b1" name="Start" type="Start"><subsheetid>90429413-7792-4513-8bc0-d6d079aa08b9</subsheetid><loginhibit /><preconditions><condition narrative="" /></preconditions><display x="15" y="-105" /><font family="Tahoma" size="10" style="Regular" color="000000" /><inputs><input type="text" name="Database" narrative="Optional. The path to the oledb database file" stage="Database" /><input type="password" name="Password" narrative="Optional. The password if required to open the oledb database." stage="Password" /><input type="text" name="Provider" narrative="Optional. Allows the database provider to be overridden." stage="Provider" /><input type="text" name="Connection String" narrative="Optional. Allows the full connecti